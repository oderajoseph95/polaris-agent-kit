{
  "name": "polaris-agent-kit",
  "version": "0.1.0",
  "description": "UNOFFICIAL community kit, not affiliated with Shopify. Rules, references and a linter that help AI coding agents (Claude Code, Cursor, GitHub Copilot, Codex, Windsurf) write Polaris 2.0 web components (s-page, s-table, s-modal) in embedded Shopify apps.",
  "type": "module",
  "license": "MIT",
  "author": "Odera Joseph Echendu (https://github.com/oderajoseph95)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oderajoseph95/polaris-agent-kit.git"
  },
  "homepage": "https://github.com/oderajoseph95/polaris-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/oderajoseph95/polaris-agent-kit/issues"
  },
  "bin": {
    "polaris-agent-kit": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "source",
    "references",
    "adapters",
    "SKILL.md",
    ".claude-plugin",
    "docs/PROVEN-ON.md",
    "docs/VERSIONING.md",
    "docs/demo/before.txt",
    "docs/demo/after.txt",
    "screenshots/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node bin/cli.mjs build",
    "build:check": "node bin/cli.mjs build --check",
    "test": "node --test",
    "prepublishOnly": "node --test && node bin/cli.mjs build --check && node scripts/publish-gate.mjs"
  },
  "keywords": [
    "polaris",
    "polaris-2",
    "polaris-web-components",
    "web-components",
    "shopify",
    "shopify-app",
    "embedded-app",
    "app-home",
    "ai-coding-agent",
    "claude-code",
    "claude-code-plugin",
    "cursor",
    "github-copilot",
    "codex",
    "windsurf",
    "agents-md",
    "agent-skills",
    "linter",
    "unofficial"
  ],
  "private": true
}
